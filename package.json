{
  "name": "bball-league-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only facts sheet for one Yahoo H2H 9-category fantasy basketball league. Reads saved Yahoo pages and ESPN box scores; never acts.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "import:draftlab": "node scripts/import-draftlab.mjs --from ../fantasy-basketball-mock-draft",
    "fetch:schedule": "node scripts/fetch-schedule.mjs",
    "build:ids": "node scripts/build-ids.mjs",
    "match:ids": "node scripts/match-ids.mjs",
    "fetch:gamelogs": "node scripts/fetch-gamelogs.mjs",
    "sheet": "node scripts/sheet.mjs",
    "capture:public": "node scripts/capture-public.mjs"
  }
}
