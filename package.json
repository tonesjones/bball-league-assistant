{
  "name": "bball-league-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "In-season assistant for one Yahoo H2H 9-category fantasy basketball league. Recommends; never acts.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "import:draftlab": "node scripts/import-draftlab.mjs --from ../fantasy-basketball-mock-draft",
    "fetch:schedule": "node scripts/fetch-schedule.mjs",
    "build:ids": "node scripts/build-ids.mjs",
    "match:ids": "node scripts/match-ids.mjs",
    "fetch:gamelogs": "node scripts/fetch-gamelogs.mjs",
    "bakeoff": "node scripts/bakeoff.mjs",
    "pilot:prepare": "node scripts/prepare-pilot.mjs",
    "advise": "node scripts/advise.mjs",
    "brief": "node scripts/brief.mjs",
    "evidence": "node scripts/player-evidence.mjs",
    "refresh:analyze": "node scripts/analyze-refresh.mjs",
    "stream": "node scripts/stream-plan.mjs"
  }
}
